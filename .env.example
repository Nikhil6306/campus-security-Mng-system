# 0009_admin_email_restriction.sql
#  and trigger trg_check_admin_role_email)
# Password Status: Password-based authentication via Supabase Auth (signInWithPassword). Passwords are encrypted/hashed and never stored in plain text.
# Password Reset Instructions:
# Open http://localhost:3000/forgot-password.
# Enter nikhilshukla1200@gmail.com and submit.
# A secure reset link pointing to /reset-password will be sent to the email address.
