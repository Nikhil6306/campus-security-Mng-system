# ---------------------------------------------------------------------------
# Campus Security Management System — environment
#
# Copy to `.env.local` and fill in. `.env*` is git-ignored: never commit real
# credentials. Only variables prefixed `NEXT_PUBLIC_` reach the browser —
# everything else stays on the server.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------

# Public origin, used to build the absolute visitor-pass links that go into
# WhatsApp messages. A relative path is useless inside a chat app, so set this
# to the real origin before sending anything a visitor will open.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------

# The bundled driver is SQLite through Node's built-in `node:sqlite` module.
# The file is created and seeded on first run; delete it to start clean.
DATABASE_FILE=.data/campus-security.db

# --- Visitor photographs ---------------------------------------------------
#
# Every booking carries a photograph of the visitor, used at the gate to check
# that the person presenting a pass is the person it was issued to.
#
# The images are written here, outside the web root, and are served only by
# `/api/visitor-photo/[id]` after a staff session has been checked. Nothing in
# `public/` ever holds a visitor's face, and the database stores the path only.
#
# On Supabase this directory is replaced by the private `campus-security`
# bucket under the `visitor-photos/` prefix — see
# `supabase/migrations/0005_visitor_photos.sql` for the storage policies.
VISITOR_PHOTO_DIR=.data/visitor-photos

# --- Aadhaar at rest -------------------------------------------------------
#
# Accompanying visitors give an Aadhaar number when a booking names more than
# one person. How it is stored depends on this one variable:
#
#   UNSET (default)  Only the last four digits are kept. The booking flow, the
#                    gate and the admin screens all work; the full number
#                    simply cannot be reproduced. Safest default — an operator
#                    who has not opted in never accumulates recoverable
#                    Aadhaar numbers.
#
#   SET              The number is sealed with AES-256-GCM before it reaches
#                    the database, and a keyed HMAC is stored for duplicate
#                    detection. Decryption is a deliberate, server-side
#                    operator action (lib/server/aadhaar.ts → openAadhaar); no
#                    route, API response or screen ever returns a full number.
#
# Generate a key:  openssl rand -base64 32
# Rotating this key makes existing ciphertext unreadable — decrypt and re-seal
# before changing it. Never give this a NEXT_PUBLIC_ prefix.
# AADHAAR_ENCRYPTION_KEY=

# --- Supabase / PostgreSQL -------------------------------------------------
#
# CONFIGURATION REQUIRED to run on Supabase. The schema and Row Level Security
# policies live in `supabase/migrations/`. Apply them to your project, then set
# the values below.
#
# The service role key bypasses RLS entirely. Keep it server-side only — it must
# never be given a NEXT_PUBLIC_ prefix.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres


# --- WhatsApp Business Platform --------------------------------------------
#
# CONFIGURATION REQUIRED for real delivery. With these unset the system uses a
# development adapter: messages are rendered and written to `whatsapp_messages`
# with the row marked "simulated", and nothing is transmitted. The admin
# settings screen reports this state plainly rather than claiming a connection.
#
# Use the official WhatsApp Business Platform (Meta Cloud API). Browser
# automation and unofficial libraries are not supported and violate the terms
# of service.

# `meta` selects the Cloud API adapter; anything else uses the development one.
WHATSAPP_PROVIDER=mock

# Permanent access token for a system user with `whatsapp_business_messaging`.
# WHATSAPP_ACCESS_TOKEN=

# The phone number ID (not the phone number itself) from WhatsApp Manager.
# WHATSAPP_PHONE_NUMBER_ID=

# The WhatsApp Business Account ID — shown on the settings screen for reference.
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Graph API version. Defaults to v21.0 when unset.
# WHATSAPP_API_VERSION=v21.0

# TEMPLATE APPROVAL: Meta allows free-form text only inside a 24-hour customer
# service window. A booking confirmation is business-initiated, so for reliable
# delivery register a utility template in WhatsApp Manager (for example
# `visit_booking_confirmation` with body variables: name, booking id, date,
# time, visitor count) and set its name below. Until a template is approved and
# named here, the Cloud API adapter sends a plain text message, which Meta will
# deliver only to recipients who messaged you in the last 24 hours.
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# Template for the message sent to a FACULTY member when a visitor asks to meet
# them. Body variables, in order: faculty name, visitor name, request number,
# visit date, visit time. Leave unset to send plain text (delivered only inside
# the 24-hour customer service window).
# WHATSAPP_FACULTY_TEMPLATE_NAME=

# The campus WhatsApp Business number in human-readable form, e.g. +919720107192.
# DISPLAY AND SUPPORT ONLY: the Cloud API always sends from the number behind
# WHATSAPP_PHONE_NUMBER_ID. This value is shown on the admin settings screen and
# in message signatures so staff and visitors know which number to expect, and
# it never selects the sender.
SECURITY_HEAD_WHATSAPP_NUMBER=+91 9876543210

# Shared secret for the delivery-receipt webhook at /api/whatsapp/webhook.
# The endpoint refuses every request until this is set, which is the safe
# default for a route no session can protect. Register the callback URL as
# https://your-domain/api/whatsapp/webhook?token=<this value>
# WHATSAPP_VERIFY_TOKEN=

# Public site origin — used for canonical URLs and social share cards.
# e.g. https://visit.dsvv.ac.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Supabase connection. Supabase is not the active Next.js database
# or authentication provider yet; do not add a service-role key to browser code.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Optional Resend transactional email. Development delivery is disabled unless
# explicitly opted in; tests mock the provider and never send real email.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=security@dsvv.ac.in
RESEND_ENABLE_DEVELOPMENT_DELIVERY=false
APP_BASE_URL=http://localhost:3000

# Optional, local-only password for seeded demo accounts. Unset means no demo
# accounts are seeded.
DEMO_ACCOUNT_PASSWORD=

# Required only when starting the backend services with Docker Compose.
# Set unique values locally; do not commit real credentials.
POSTGRES_PASSWORD=your_postgres_password_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here



